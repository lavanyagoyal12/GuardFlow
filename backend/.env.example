# Copy this file to ".env" (same folder) and adjust as needed.
# The app reads config from environment variables / this file via
# app/core/settings.py - nothing else needs to change.

# --- Qualcomm GenieX local semantic-analysis service ---
# Start it in a separate terminal with: geniex serve
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:18181
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_0

# A first request may include model-loading time. Increase this only if logs
# report a timeout; failures always fall back to deterministic scoring.
LLM_TIMEOUT=45
LLM_MAX_TOKENS=320

# --- App config (all optional, shown with defaults) ---
# APP_NAME=GuardFlow
# HOST=0.0.0.0
# PORT=8000
# DEBUG=False
# DATABASE_URL=sqlite:///./data/guardflow.db
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=["http://localhost:5173"]
